# Copy file nay thanh .env cung thu muc roi dien gia tri that.
# File .env KHONG duoc commit (da nam trong .gitignore).
#
# Chay script:
#   node --env-file=scripts/agent/.env scripts/agent/resolve-disputes.mjs

# Groq - lay tai https://console.groq.com/keys
GROQ_API_KEY=

# Latch - lay ca 2 gia tri o trang Connect trong dashboard Latch
LATCH_PROXY_URL=
LATCH_API_KEY=

# Doc contract (chi doc, khong ky). Dung lai gia tri trong .env.local cua frontend.
RPC_URL=
FACTORY_ADDRESS=

# Tuy chon - chi dat khi muon doi mac dinh
# GROQ_MODEL=qwen/qwen3.6-27b
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# LUU Y: KHONG dat AGENT_PRIVATE_KEY o day. Script nay khong duoc ky giao dich.
# Private key chi nam trong .env.local cua server (API route), agent khong doc duoc.
